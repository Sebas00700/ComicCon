@model Seg3.Models.AsistenteComicCon

@{
    ViewData["Title"] = "Pase Comic-Con";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-warning">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">🎫Tu Pase Oficial Comic-Con</h4>
                </div>
                <div class="card-body text-center">
                    <p class="lead">@Model.MensajeConfirmacion</p>
                    <p class="text-muted">Correo registrado: @Model.Correo</p>
                    <hr />
                    <a asp-action="Index" class="btn btn-dark">Registrar otro asistente</a>
                </div>
            </div>
        </div>
    </div>
</div>